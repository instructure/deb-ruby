From: Nobuyoshi Nakada <nobu@ruby-lang.org>
Date: Fri, 6 Feb 2026 14:42:29 +0900
Subject: Pass only -D/-U options from CPPFLAGS to dtrace

4.0 started passing all of CPPFLAGS to dtrace, and systemtap's dtrace
rejects the Debian hardening flag -Wdate-time, so probes.h fails to
build. Backport of the Makefile.in part of the upstream fix, using
the shell loop from the follow-up commit that dropped GNU sed.

Bug: https://bugs.ruby-lang.org/issues/21862
Origin: upstream, https://github.com/ruby/ruby/commit/c46fe31138d2a76c6121c444135f5cb97e782ec7
Origin: upstream, https://github.com/ruby/ruby/commit/cdb1a42949e7002cf426a6060294d60360cb1fc3
---
--- a/template/Makefile.in
+++ b/template/Makefile.in
@@ -513,7 +513,10 @@
 
 .d.h:
 	@$(ECHO) translating probes $<
-	$(Q) $(DTRACE) -o $@.tmp -h -C $(INCFLAGS) $(CPPFLAGS) -s $<
+	$(Q) set x -o $@.tmp -h -C $(INCFLAGS); \
+	for flag in $(CPPFLAGS); do case $$flag in -[DU]*) set "$$@" "$$flag";; esac; done; \
+	shift; \
+	$(DTRACE) "$$@" -s $<
 	$(Q) sed -e 's/RUBY_/RUBY_DTRACE_/g' -e 's/PROBES_H_TMP/RUBY_PROBES_H/' -e 's/(char \*/(const char */g' -e 's/, char \*/, const char */g' $@.tmp > $@
 	$(Q) $(RM) $@.tmp
 
