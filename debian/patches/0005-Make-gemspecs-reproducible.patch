From: Lucas Kanashiro <kanashiro@debian.org>
Date: Fri, 1 Nov 2019 15:25:17 -0300
Subject: Make gemspecs reproducible

Without an explicit date, they will get the current date and make the
build unreproducible
---
 ext/io/console/io-console.gemspec | 1 +
 lib/ipaddr.gemspec                | 1 +
 2 files changed, 2 insertions(+)

Index: deb-ruby/ext/io/console/io-console.gemspec
===================================================================
--- deb-ruby.orig/ext/io/console/io-console.gemspec
+++ deb-ruby/ext/io/console/io-console.gemspec
@@ -12,6 +12,7 @@ end
 Gem::Specification.new do |s|
   s.name = "io-console"
   s.version = _VERSION
+  s.date = RUBY_RELEASE_DATE
   s.summary = "Console interface"
   s.email = "nobu@ruby-lang.org"
   s.description = "add console capabilities to IO instances."
Index: deb-ruby/lib/ipaddr.gemspec
===================================================================
--- deb-ruby.orig/lib/ipaddr.gemspec
+++ deb-ruby/lib/ipaddr.gemspec
@@ -18,6 +18,7 @@ end
 Gem::Specification.new do |spec|
   spec.name          = "ipaddr"
   spec.version       = version
+  spec.date          = RUBY_RELEASE_DATE
   spec.authors       = ["Akinori MUSHA", "Hajimu UMEMOTO"]
   spec.email         = ["knu@idaemons.org", "ume@mahoroba.org"]
 
